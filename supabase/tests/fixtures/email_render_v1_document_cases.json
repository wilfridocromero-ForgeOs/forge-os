        "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Hola</title>\n</head>\n<body>\n<p>Linea 1<br>a<br>b</p>\n<div data-orvesen-footer=\"email-footer.v1\">\n<hr>\n<p>Acme</p>\n<p><a href=\"https://u.example.com/u?t=abc\">Darse de baja</a></p>\n</div>\n</body>\n</html>\n",
