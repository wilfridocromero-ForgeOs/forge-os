{
  "format": "email-render-document.v1",
  "description": "Hand-authored document-assembly vectors for Increment 3b (docs/email-marketing/EMAIL_CONTENT_V1_CONTRACT.md section 9). Each case renders 'template' with 'values' (renderTemplate) and assembles the result with 'footer' (assembleDocument). 'footer' absent means the argument is omitted. 'expected' is either the exact document {html, text} (LF line breaks, final LF) or an assembly error {error, field?, reason?}. Every template is valid email-content.v1 (checked against PostgreSQL by the Increment 3b differential suite). Expected outputs were written by hand from the contract, never generated by the renderer under test.",
  "cases": [
    {
      "name": "complete document: heading, paragraph, button, hidden preheader and system footer",
      "template": {"subject": "Hola {{contact.first_name}}", "preheader": "Novedades de {{organization.name}}", "content": {"version": "email-content.v1", "blocks": [
        {"type": "heading", "level": 1, "text": "Bienvenida"},
        {"type": "paragraph", "text": "Hola {{contact.first_name}}, gracias."},
        {"type": "button", "text": "Ver ofertas", "url": "https://a.example.com/ofertas"}]}},
      "values": {"contact": {"first_name": "Ana", "last_name": null, "email": "ana@example.com"}, "organization": {"name": "Acme"}, "custom": {}, "archived_custom": []},
      "footer": {"version": "email-footer.v1", "organization_name": "Acme", "unsubscribe_label": "Darse de baja", "unsubscribe_url": "https://u.example.com/u?t=abc", "notice": null},
      "expected": {
        "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Hola Ana</title>\n</head>\n<body>\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">Novedades de Acme</div>\n<h1>Bienvenida</h1>\n<p>Hola Ana, gracias.</p>\n<p><a href=\"https://a.example.com/ofertas\">Ver ofertas</a></p>\n<div data-orvesen-footer=\"email-footer.v1\">\n<hr>\n<p>Acme</p>\n<p><a href=\"https://u.example.com/u?t=abc\">Darse de baja</a></p>\n</div>\n</body>\n</html>\n",
        "text": "Bienvenida\n\nHola Ana, gracias.\n\nVer ofertas\nhttps://a.example.com/ofertas\n\n-- \nAcme\nDarse de baja: https://u.example.com/u?t=abc\n"
      }
    },
    {
      "name": "no preheader in the template: no hidden preheader line",
      "template": {"subject": "Hola", "preheader": null, "content": {"version": "email-content.v1", "blocks": [{"type": "paragraph", "text": "Texto"}]}},
      "values": {"contact": {"first_name": "Ana", "last_name": null, "email": "ana@example.com"}, "organization": {"name": "Acme"}, "custom": {}, "archived_custom": []},
      "footer": {"version": "email-footer.v1", "organization_name": "Acme", "unsubscribe_label": "Darse de baja", "unsubscribe_url": "https://u.example.com/u?t=abc", "notice": null},
      "expected": {
        "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Hola</title>\n</head>\n<body>\n<p>Texto</p>\n<div data-orvesen-footer=\"email-footer.v1\">\n<hr>\n<p>Acme</p>\n<p><a href=\"https://u.example.com/u?t=abc\">Darse de baja</a></p>\n</div>\n</body>\n</html>\n",
        "text": "Texto\n\n-- \nAcme\nDarse de baja: https://u.example.com/u?t=abc\n"
      }
    },
    {
      "name": "preheader that is empty after substitution is omitted, like no preheader at all",
      "template": {"subject": "Hola", "preheader": "{{contact.last_name}}", "content": {"version": "email-content.v1", "blocks": [{"type": "paragraph", "text": "Texto"}]}},
      "values": {"contact": {"first_name": "Ana", "last_name": null, "email": "ana@example.com"}, "organization": {"name": "Acme"}, "custom": {}, "archived_custom": []},
      "footer": {"version": "email-footer.v1", "organization_name": "Acme", "unsubscribe_label": "Darse de baja", "unsubscribe_url": "https://u.example.com/u?t=abc"},
      "expected": {
        "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Hola</title>\n</head>\n<body>\n<p>Texto</p>\n<div data-orvesen-footer=\"email-footer.v1\">\n<hr>\n<p>Acme</p>\n<p><a href=\"https://u.example.com/u?t=abc\">Darse de baja</a></p>\n</div>\n</body>\n</html>\n",
        "text": "Texto\n\n-- \nAcme\nDarse de baja: https://u.example.com/u?t=abc\n"
      }
