{
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/clientes", "destination": "/index.html" },
    { "source": "/clientes/:path*", "destination": "/index.html" },
    { "source": "/discovery", "destination": "/index.html" },
    { "source": "/discovery/:path*", "destination": "/index.html" },
    { "source": "/proyectos", "destination": "/index.html" },
    { "source": "/proyectos/:path*", "destination": "/index.html" },
    { "source": "/orvesen-score", "destination": "/index.html" },
    { "source": "/business-score", "destination": "/index.html" },
    { "source": "/configuracion", "destination": "/index.html" },
    { "source": "/configuracion/:path*", "destination": "/index.html" },
    { "source": "/calendario", "destination": "/index.html" },
    { "source": "/cerebro", "destination": "/index.html" },
    { "source": "/construir", "destination": "/index.html" },
    { "source": "/score-builder", "destination": "/index.html" }
  ]
}
